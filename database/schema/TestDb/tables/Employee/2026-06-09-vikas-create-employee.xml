<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
           http://www.liquibase.org/xml/ns/dbchangelog
           https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Create Employee Table -->
    <changeSet id="001-create-employee-table" author="chatgpt">
        <createTable schemaName="testdb" tableName="Employee">

            <column name="empid" type="BIGINT">
                <constraints primaryKey="true"
                             primaryKeyName="pk_employee"
                             nullable="false"/>
            </column>

            <column name="empname" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="age" type="INT"/>

            <column name="contactno" type="VARCHAR(20)"/>

            <column name="phone" type="VARCHAR(20)"/>

            <column name="email" type="VARCHAR(255)">
                <constraints unique="true"
                             uniqueConstraintName="uk_employee_email"/>
            </column>

        </createTable>
    </changeSet>

</databaseChangeLog>